1	"""asyncpg connection-pool lifecycle helpers."""
2	
3	import asyncpg
4	
5	from app.config import DATABASE_URL
6	
7	_pool: asyncpg.Pool | None = None
8	
9	
10	async def init_pool() -> asyncpg.Pool:
11	    """Create the shared pool and ensure the application's table exists."""
12	    global _pool
13	
14	    if _pool is None:
15	        _pool = await asyncpg.create_pool(DATABASE_URL)
16	        async with _pool.acquire() as connection:
17	            await connection.execute(
18	                """
19	                CREATE TABLE IF NOT EXISTS letters (
20	                    id SERIAL PRIMARY KEY,
21	                    value CHAR(1) NOT NULL,
22	                    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
23	                )
24	                """
25	            )
26	    return _pool
27	
28	
29	async def close_pool() -> None:
30	    """Close and clear the shared pool, if it has been initialized."""
31	    global _pool
32	
33	    if _pool is not None:
34	        await _pool.close()
35	        _pool = None
36	
37	
38	async def get_pool() -> asyncpg.Pool:
39	    """Return the initialized pool."""
40	    if _pool is None:
41	        raise RuntimeError("Database pool has not been initialized")
42	    return _pool
