1	"""Raw-SQL data access for letters."""
2	
3	from app.db import get_pool
4	
5	
6	async def insert_letter(value: str) -> dict:
7	    """Persist a letter and return the created row."""
8	    pool = await get_pool()
9	    async with pool.acquire() as connection:
10	        record = await connection.fetchrow(
11	            """
12	            INSERT INTO letters (value)
13	            VALUES ($1)
14	            RETURNING id, value, created_at
15	            """,
16	            value,
17	        )
18	    return dict(record)
19	
20	
21	async def list_letters() -> list[dict]:
22	    """Return all persisted letters, newest first."""
23	    pool = await get_pool()
24	    async with pool.acquire() as connection:
25	        records = await connection.fetch(
26	            """
27	            SELECT id, value, created_at
28	            FROM letters
29	            ORDER BY created_at DESC, id DESC
30	            """
31	        )
32	    return [dict(record) for record in records]
33	
34	
35	async def get_letter(letter_id: int) -> dict | None:
36	    """Return a letter by primary key, or ``None`` when absent."""
37	    pool = await get_pool()
38	    async with pool.acquire() as connection:
39	        record = await connection.fetchrow(
40	            """
41	            SELECT id, value, created_at
42	            FROM letters
43	            WHERE id = $1
44	            """,
45	            letter_id,
46	        )
47	    return dict(record) if record is not None else None
