yncpg to localhost:5432\\"\\n)\\nCHECKS = [\\n    (\\"POST\\", \\"/letters/generate\\", \\"Generate and persist one random letter\\"),\\n    (\\"GET\\", \\"/letters\\", \\"List persisted letters, newest first\\"),\\n    (\\"GET\\", \\"/letters/999999\\", \\"Return the specified missing-letter response\\"),\\n]\\n\\n\\ndef run_check(method: str, endpoint: str, description: str) -> dict:\\n    request = urllib.request.Request(\\n        f\\"http://localhost:8000{endpoint}\\", method=method\\n    )\\n    try:\\n        with urllib.request.urlopen(request, timeout=3) as response:\\n            status = response.status\\n            passed = 200 <= status < 300 or (endpoint.endswith(\\"999999\\") and status == 404)\\n            return {\\n                \\"Method\\": method,\\n                \\"Endpoint\\": endpoint,\\n                \\"Description\\": description,\\n                \\"Status Code\\": status,\\n                \\"Pass/Fail\\": \\"PASS\\" if passed else \\"FAIL\\",\\n                \\"Reason\\": \\"Live HTTP response received\\",\\n            }\\n    except (urllib.error.URLError, TimeoutError) as error:\\n        return {\\n            \\"Method\\": method,\\n            \\"Endpoint\\": endpoint,\\n            \\"Description\\": description,\\n            \\"Status Code\\": \\"N/A\\",\\n            \\"Pass/Fail\\": \\"FAIL\\",\\n            \\"Reason\\": f\\"{BOOT_FAILURE}; report probe observed {error.reason}\\",\\n        }\\n\\n\\nARTIFACTS.mkdir(exist_ok=True)\\nresults = [run_check(*check) for check in CHECKS]\\n(ARTIFACTS / \\"test_results.json\\").write_text(json.dumps(results, indent=2), encoding=\\"utf-8\\")\\n\\nworkbook = Workbook()\\nsheet = workbook.active\\nsheet.title = \\"API Test Report\\"\\nsheet.append([\\"#\\", \\"Method\\", \\"Endpoint\\", \\"Description\\", \\"Status Code\\", \\"Pass/Fail\\", \\"Reason\\"])\\nfor index, result in enumerate(results, start=1):\\n    sheet.append([index, *(result[key] for key in [\\"Method\\", \\"Endpoint\\", \\"Description\\", \\"Status Code\\", \\"Pass/Fail\\", \\"Reason\\"])])\\nfor column in sheet.columns:\\n    sheet.column_dimensions[column[0].column_letter].width = min(\\n        max(len(str(cell.value or \\"\\")) for cell in column) + 2, 100\\n    )\\nworkbook.save(ARTIFACTS / \\"api_test_report.xlsx\\")\\n\\ndocument = Document()\\ndocument.add_heading(\\"Random Letter Generator — Project Summary\\", 0)\\ndocument.add_paragraph(\\"FastAPI 0.115.6 service using an asyncpg pool and raw PostgreSQL SQL.\\")\\ndocument.add_heading(\\"Implemented API\\", level=1)\\ndocument.add_paragraph(\\"POST /letters/generate; GET /letters; GET /letters/{letter_id}.\\")\\ndocument.add_heading(\\"Verification\\", level=1)\\ndocument.add_paragraph(\\"Dependency installation, import, and bytecode compilation passed.\\")\\ndocument.add_paragraph(\\n    \\"Live API verification was attempted three times but could not start because PostgreSQL \\"\\n    \\"was unavailable at the configured localhost:5432 endpoint. The workbook contains the \\"\\n    \\"actual refused-connection probes and is intentionally marked FAIL rather than predicted results.\\"\\n)\\ndocument.save(ARTIFACTS / \\"project_report.docx\\")\\n"}', 'call_id': 'call_91jwgV78rVJbPy9y9EFOKBFL', 'name': 'write_file', 'type': 'function_call', 'id': 'fc_0a9761271a6145fc006ab4ebe7296c87d2b6963c1dbfb57292', 'status': 'completed'}]
